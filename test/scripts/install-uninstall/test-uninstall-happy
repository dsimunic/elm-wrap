# APP-06: Uninstall package from application with dependency cycle
test_app_06_uninstall_cycle_from_application() {
    local since_before since_after delta
    since_before=$(get_v1_since_count)

    echo "=== BEGIN APP-06: Uninstall package cycle from application ==="

    local app_dir
    app_dir=$(create_app "$TEST_ROOT/app06" "app06")

    cat >"$app_dir/elm.json" <<'EOF'
{
    "type": "application",
    "source-directories": [
        "src"
    ],
    "elm-version": "0.19.1",
    "dependencies": {
        "direct": {
            "elm/browser": "1.0.2",
            "elm/core": "1.0.5",
            "elm/html": "1.0.1",
            "elm/url": "1.0.0",
            "wrap/cycle-a": "1.0.0"
        },
        "indirect": {
            "elm/json": "1.1.4",
            "elm/time": "1.0.0",
            "elm/virtual-dom": "1.0.5",
            "wrap/cycle-b": "1.0.0"
        }
    },
    "test-dependencies": {
        "direct": {},
        "indirect": {}
    }
}
EOF

    cd "$app_dir"
    run_wrap package uninstall wrap/cycle-a

    assert_no_dep "wrap/cycle-a" "$app_dir"
    assert_no_dep "wrap/cycle-b" "$app_dir"

    since_after=$(get_v1_since_count)
    delta=$((since_after - since_before))
    echo "[Registry since-count: $since_before -> $since_after (Δ$delta)]"
    echo "=== END APP-06 ==="
    echo
}

