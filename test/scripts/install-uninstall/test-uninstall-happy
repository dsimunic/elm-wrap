# PKG-03: Uninstall package from package elm.json with dependency cycle
test_pkg_03_uninstall_cycle_from_package() {
    local since_before since_after delta
    since_before=$(get_v1_since_count)

    echo "=== BEGIN PKG-03: Uninstall package cycle from package ==="

    local pkg_dir
    pkg_dir=$(create_package "$TEST_ROOT/pkg03" "wrap/cycle-a")

    cat >"$pkg_dir/elm.json" <<'EOF'
{
    "type": "package",
    "name": "wrap/cycle-a",
    "summary": "Cycle test package",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [],
    "elm-version": "0.19.1 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "wrap/cycle-b": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {}
}
EOF

    cd "$pkg_dir"
    run_wrap package uninstall wrap/cycle-b

    if grep -Fq '"wrap/cycle-b"' "$pkg_dir/elm.json"; then
        echo "ERROR: Uninstall did not remove wrap/cycle-b from package elm.json"
        exit 1
    fi

    since_after=$(get_v1_since_count)
    delta=$((since_after - since_before))
    echo "[Registry since-count: $since_before -> $since_after (Δ$delta)]"
    echo "=== END PKG-03 ==="
    echo
}

# =============================================================================
# Main
# =============================================================================

main() {
    echo "Running uninstall-happy tests..."
    echo
    echo
    
    # Run all test cases
    test_app_01_uninstall_single_package
    test_app_02_uninstall_removing_orphans
    test_app_03_uninstall_keeping_shared
    test_app_04_uninstall_direct_still_needed_indirect
    test_app_05_uninstall_test_dependency
    test_app_06_uninstall_cycle_from_application
    test_pkg_01_uninstall_single_from_package
    test_pkg_02_uninstall_with_deps_from_package
    test_pkg_03_uninstall_cycle_from_package
    
    local since_after delta
    since_after=$(get_v1_since_count)
    delta=0
    echo
    echo "[Registry since-count: $since_after -> $since_after (Δ$delta)]"
    echo "=== END ==="
    echo
    echo "All uninstall-happy tests completed successfully"
}

main "$@"
